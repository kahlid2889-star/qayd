# انسخ هذا الملف إلى .env على الخادم واملأ القيم هناك.
# لا ترفع .env إلى أي مستودع عام.

# كلمة قاعدة Postgres التي ينشئها docker-compose
POSTGRES_PASSWORD=غيّرها-بكلمة-طويلة

# عنوان القاعدة الذي يراه تطبيق قيد. داخل Docker الاسم db هو اسم الخدمة.
DATABASE_URL=postgres://qayd:غيّرها-بكلمة-طويلة@db:5432/qayd

# سر جلسات الدخول. أنشئه على الخادم ولا تضعه في الأرشيف:
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# الرابط العلني الذي يفتحه اللاعبون، مع https ومن غير شرطة أخيرة.
# مثال: https://play.example.com
BETTER_AUTH_URL=https://play.example.com

# النطاق وحده من غير https، يقرؤه Caddy ليصدر الشهادة.
# مثال: play.example.com
QAYD_DOMAIN=play.example.com

# الإبقاء على الحسابات مفعّلة.
VITE_AUTH_ENABLED=true

# أزرار Google و X تعمل على منصة Grok فقط. على خادمك تبقى مخفية.
VITE_SOCIAL_LOGIN=false

# لا تملأ هذه. هي مفاتيح وسيط دخول Grok ولا تعمل على نطاقك.
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
# GROK_PROJECT_ID=

# Supabase (اختياري). المفاتيح من لوحة Supabase: Project Settings > API Keys.
# رابط المشروع يشبه https://xxxx.supabase.co
SUPABASE_URL=
# المفتاح السري: للخادم فقط، لا يوضع في المتصفح ولا في المستودع.
SUPABASE_SECRET_KEY=
# المفتاح العلني: آمن للمتصفح، وصلاحياته تحددها سياسات RLS في Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- النظام الجديد /v2 (حسابات وأصدقاء وغرف عبر Supabase) ---
# يكفي هذان للمتصفح. المفتاح السري لا يدخل هنا: هو للخادم فقط ولا تحتاجه هذه المرحلة.
# VITE_SUPABASE_URL و VITE_SUPABASE_PUBLISHABLE_KEY موجودان أعلاه.
